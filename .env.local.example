# Neon (Postgres) — connection string del proyecto
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Secreto para firmar las cookies de sesión (genera uno: openssl rand -hex 32)
AUTH_SECRET=cambia-esto-por-un-secreto-aleatorio

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (emails)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=GHL Titan <onboarding@resend.dev>
EMAIL_ADMIN=tu-email@ejemplo.com
# Token del cron que procesa los emails programados de automatizaciones
CRON_SECRET=cambia-esto-por-un-token-secreto

# IA (generación de páginas de funnels y reescritura de textos) — PRP-009
# Consíguela en https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Opcional: modelo a usar (por defecto anthropic/claude-sonnet-4.5)
OPENROUTER_MODEL=
